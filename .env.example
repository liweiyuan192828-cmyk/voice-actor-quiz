NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 后台初始管理员口令，请改成强密码。留空时后台写入接口会拒绝请求。
ADMIN_ACCESS_KEY=change-this-to-a-long-random-password
# true 时，必须至少点击播放一次才可答题；false 时可直接答题
NEXT_PUBLIC_REQUIRE_AUDIO_PLAYED=true
